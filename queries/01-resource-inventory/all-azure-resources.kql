// Query ID: ARG-001
// Name: Complete Azure Resource Inventory
//
// Purpose:
// Produce an inventory of Azure resources across the subscriptions
// selected in Azure Resource Graph Explorer.
//
// Important:
// Query results depend on the selected subscription scope and the
// permissions of the person executing the query.
//
// Handling:
// Do not commit the exported CSV results to this repository.

Resources
| project
    subscriptionId,
    resourceGroup,
    type,
    name,
    location,
    kind,
    skuName = tostring(sku.name),
    resourceId = id,
    tags
| order by type asc, name asc
